# Supabase session pooler connection string (direct connection is IPv6-only on the free plan)
DATABASE_URL=postgresql://postgres:password@localhost:5432/salary_management
# Set to "true" for Supabase / hosted Postgres, "false" for local Docker Postgres
DATABASE_SSL=false
# Allowed browser origin for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:5173
PORT=3000
